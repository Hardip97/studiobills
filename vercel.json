{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/privacy-policy.html", "dest": "/privacy-policy.html" },
    { "src": "/terms-of-service.html", "dest": "/terms-of-service.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
